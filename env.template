# Environment Configuration Template

ENVIRONMENT=dev

# PostgreSQL
POSTGRES_AUTH_DB=auth_db
POSTGRES_AUTH_USER=auth_user
POSTGRES_AUTH_PASSWORD=auth_password_change_me

POSTGRES_PRODUCT_DB=product_db
POSTGRES_PRODUCT_USER=product_user
POSTGRES_PRODUCT_PASSWORD=product_password_change_me

POSTGRES_ORDER_DB=order_db
POSTGRES_ORDER_USER=order_user
POSTGRES_ORDER_PASSWORD=order_password_change_me

POSTGRES_PAYMENT_DB=payment_db
POSTGRES_PAYMENT_USER=payment_user
POSTGRES_PAYMENT_PASSWORD=payment_password_change_me

POSTGRES_NOTIFICATION_DB=notification_db
POSTGRES_NOTIFICATION_USER=notification_user
POSTGRES_NOTIFICATION_PASSWORD=notification_password_change_me

CLUSTER_ID=random-uuid

# Redis
REDIS_CACHE_PASSWORD=cache_password_change_me
REDIS_CATALOG_PASSWORD=catalog_password_change_me
REDIS_RATELIMIT_PASSWORD=ratelimit_password_change_me
REDIS_SESSION_PASSWORD=session_password_change_me
REDIS_CART_PASSWORD=cart_password_change_me

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin_change_me

# JWT & Security
JWT_SECRET=your_jwt_secret_key_change_me_minimum_256_bits
JWT_EXPIRATION=86400000

# Gateway Service Authentication
GATEWAY_SERVICE_SECRET=gateway-secret-change-me

# Service URLs (for Docker use service names, for local dev use localhost)
# Comment/uncomment based on your environment:

# Option 1: Docker deployment (default)
AUTH_SERVICE_URL=http://auth-service:8081
PRODUCT_SERVICE_URL=http://product-service:8083
CART_SERVICE_URL=http://cart-service:8084
PAYMENT_SERVICE_URL=http://payment-service:8085
NOTIFICATION_SERVICE_URL=http://notification-service:8086
LOGISTICS_SERVICE_URL=http://logistics-service:8087
ANALYTICS_SERVICE_URL=http://analytics-service:8088
LISTENER_SERVICE_URL=http://listener-service:8089
METRICS_SERVICE_URL=http://metrics-service:8090

# Option 2: Local development (uncomment to use)
# AUTH_SERVICE_URL=http://localhost:8081
# PRODUCT_SERVICE_URL=http://localhost:8083
# CART_SERVICE_URL=http://localhost:8084
# PAYMENT_SERVICE_URL=http://localhost:8085
# NOTIFICATION_SERVICE_URL=http://localhost:8086
# LOGISTICS_SERVICE_URL=http://localhost:8087
# ANALYTICS_SERVICE_URL=http://localhost:8088
# LISTENER_SERVICE_URL=http://localhost:8089
# METRICS_SERVICE_URL=http://localhost:8090



